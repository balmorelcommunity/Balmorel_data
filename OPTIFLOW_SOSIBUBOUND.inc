SOSIBUBOUND(Y,AAA,PROC,FLOW,'ILOUPFX_UP')$(AAAOPTIFLOW(AAA) AND (NOT SOSIBUBOUND(Y,AAA,PROC,FLOW,'ILOUPFX_UP')) AND SUM(IAE,SOSIBUBOUND(Y,IAE,PROC,FLOW,'ILOUPFX_UP')))=EPS;                                                                                                                                                         
                                                                                                                                                                                                                                                                                                                                     
SOSIBUBOUND(Y,AAA,PROC,FLOW,'ILOUPFX_FX')$(AAAOPTIFLOW(AAA) AND (NOT SOSIBUBOUND(Y,AAA,PROC,FLOW,'ILOUPFX_FX')) AND SUM(IAE,SOSIBUBOUND(Y,IAE,PROC,FLOW,'ILOUPFX_FX')))=EPS;                                                                                                                                                         
                                                                                                                                                                                                                                                                                                                                     
* Only assign upper bounds if not already set                                                                                                                                                                                                                                                                                        
SOSIBUBOUND(Y,AAA,PROC,FLOW,'ILOUPFX_UP')$(NOT SOSIBUBOUND(Y,AAA,PROC,FLOW,'ILOUPFX_UP') AND SOSIBUBOUND('2030',AAA,PROC,FLOW,'ILOUPFX_UP')) = SOSIBUBOUND('2030',AAA,PROC,FLOW,'ILOUPFX_UP');                                                                                                                                       
                                                                                                                                                                                                                                                                                                                                     
* Only assign lower bounds if not already set                                                                                                                                                                                                                                                                                        
SOSIBUBOUND(Y,AAA,PROC,FLOW,'ILOUPFX_LO')$(NOT SOSIBUBOUND(Y,AAA,PROC,FLOW,'ILOUPFX_LO') AND SOSIBUBOUND('2030',AAA,PROC,FLOW,'ILOUPFX_LO')) = SOSIBUBOUND('2030',AAA,PROC,FLOW,'ILOUPFX_LO');                                                                                                                                       
                                                                                                                                                                                                                                                                                                                                     
* Only assign fixed values if not already set                                                                                                                                                                                                                                                                                        
