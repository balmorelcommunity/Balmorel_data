*Equation to ensure that in those areas where there is written no potential, there is no consumption of resource                                                                                                                                                                  
SOSIBUBOUND(Y,AAA,PROC,FLOW,'ILOUPFX_UP')$(AAAOPTIFLOW(AAA) AND (NOT SOSIBUBOUND(Y,AAA,PROC,FLOW,'ILOUPFX_UP')) AND SUM(IAE,SOSIBUBOUND(Y,IAE,PROC,FLOW,'ILOUPFX_UP')))=EPS;                                                                                                      
SOSIBUBOUND(Y,AAA,PROC,FLOW,'ILOUPFX_FX')$(AAAOPTIFLOW(AAA) AND (NOT SOSIBUBOUND(Y,AAA,PROC,FLOW,'ILOUPFX_FX')) AND SUM(IAE,SOSIBUBOUND(Y,IAE,PROC,FLOW,'ILOUPFX_FX')))=EPS;                                                                                                      
                                                                                                                                                                                                                                                                                  
*Generalise transport demand                                                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                                                  
***Aviation                                                                                                                                                                                                                                                                       
SOSIBUBOUND('2030',AAA,'AirBuffer','AIRFLOW',iLOUPFXSET) = SOSIBUBOUND('2050',AAA,'AirBuffer','AIRFLOW',iLOUPFXSET)*0.1;                                                                                                                                                          
SOSIBUBOUND('2040',AAA,'AirBuffer','AIRFLOW',iLOUPFXSET) = SOSIBUBOUND('2050',AAA,'AirBuffer','AIRFLOW',iLOUPFXSET)*0.5;                                                                                                                                                          
                                                                                                                                                                                                                                                                                  
***Road                                                                                                                                                                                                                                                                           
SOSIBUBOUND('2030',AAA,'RoadBuffer','ROADFLOW',iLOUPFXSET) = SOSIBUBOUND('2050',AAA,'RoadBuffer','ROADFLOW',iLOUPFXSET)*0.1;                                                                                                                                                      
SOSIBUBOUND('2040',AAA,'RoadBuffer','ROADFLOW',iLOUPFXSET) = SOSIBUBOUND('2050',AAA,'RoadBuffer','ROADFLOW',iLOUPFXSET)*0.5;                                                                                                                                                      
                                                                                                                                                                                                                                                                                  
***Shipping                                                                                                                                                                                                                                                                       
SOSIBUBOUND('2030',AAA,'SeaBuffer','SEAFLOW',iLOUPFXSET) = SOSIBUBOUND('2050',AAA,'SeaBuffer','SEAFLOW',iLOUPFXSET)*0.1;                                                                                                                                                          
SOSIBUBOUND('2040',AAA,'SeaBuffer','SEAFLOW',iLOUPFXSET) = SOSIBUBOUND('2050',AAA,'SeaBuffer','SEAFLOW',iLOUPFXSET)*0.5;                                                                                                                                                          
                                                                                                                                                                                                                                                                                  
*Biogas                                                                                                                                                                                                                                                                           
SOSIBUBOUND('2030',AAA,'Manure_Gen','MANURE_GEN_FLOW',iLOUPFXSET) = SOSIBUBOUND('2050',AAA,'Manure_Gen','MANURE_GEN_FLOW',iLOUPFXSET);                                                                                                                                            
SOSIBUBOUND('2040',AAA,'Manure_Gen','MANURE_GEN_FLOW',iLOUPFXSET) = SOSIBUBOUND('2050',AAA,'Manure_Gen','MANURE_GEN_FLOW',iLOUPFXSET);                                                                                                                                            
