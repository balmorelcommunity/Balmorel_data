PARAMETER                                            FUELPRICE(YYY,AAA,FFF);                                                                                                                                                                                                                                                  
FUELPRICE(YYY,AAA,FFF)                               =                       SUM(RRR,                          FUELPRICE1(YYY,RRR,FFF)*RRRAAA(RRR,AAA));                                                                                                                                                                      
                                                                                                                                                                                                                                                                                                                              
*                                                    Unless                  other                             values                                    are                     assigned in                              the         TABLE  FUELPRICE above,                                                                 
*                                                    the                     values                            for                                       BE_A'                  are      used                            for         all    A:                                                                               
FUELPRICE('2015',AAA,FFF)$(FUELPRICE('2015',AAA,FFF) EQ                      0)=FUELPRICE('2015','BE_A',FFF);                                                                                                                                                                                                                
FUELPRICE(YYY,AAA,FFF)$((YYY.val                     >                       2014)                             and                                       (FUELPRICE(YYY,AAA,FFF) EQ       0))=FUELPRICE(YYY,'BE_A',FFF);                                                                                                     
