TABLE SOSIBUFLOW_VAR_T(AAA,PROC,FLOW,SSS,TTT) 'Variation in some Source, Sink or Buffer Flows over the year'
;

SOSIBUFLOW_VAR_T(IA,'Wood_Gen','WOOD_GEN_FLOW',S,T)$(AAAOPTIFLOW(IA)AND(not AAATRANSIT(IA)))=1;
SOSIBUFLOW_VAR_T(IA,'Straw_Gen','STRAW_GEN_FLOW',S,T)$(AAAOPTIFLOW(IA)AND(not AAATRANSIT(IA)))=1;
SOSIBUFLOW_VAR_T(IA,'Manure_Gen','MANURE_GEN_FLOW',S,T)$(AAAOPTIFLOW(IA)AND(not AAATRANSIT(IA)))=1;

SOSIBUFLOW_VAR_T(IA,'Gas_Buffer','SNG_FLOW',S,T)$(AAAOPTIFLOW(IA)AND(not AAATRANSIT(IA)))=1;

SOSIBUFLOW_VAR_T(IA,'CO2_Seq_On_Buffer','CO2_FLOW_SEQ_ON',S,T)$(AAAOPTIFLOW(IA)AND(not AAATRANSIT(IA)))=1;

SOSIBUFLOW_VAR_T(IA,'CO2_Seq_Off_Buffer','CO2_FLOW_SEQ_OFF',S,T)$(AAAOPTIFLOW(IA)AND(not AAATRANSIT(IA)))=1;

SOSIBUFLOW_VAR_T(IA,'IFUELPRICE_BUFFER',FLOW,S,T)$(SUM((Y,iLOUPFXSET),SOSIBUBOUND(Y,IA,'IFUELPRICE_BUFFER',FLOW,iLOUPFXSET))>0 AND AAAOPTIFLOW(IA) AND NOT AAATRANSIT(IA)) = 1;
SOSIBUFLOW_VAR_T(IA,'RETRO_BUFFER','VIRTUALFLOW_RETRO',SSS,T)$(SUM((Y,iLOUPFXSET),SOSIBUBOUND(Y,IA,'RETRO_BUFFER','VIRTUALFLOW_RETRO',iLOUPFXSET))>0 AND AAAOPTIFLOW(IA) AND NOT AAATRANSIT(IA)) = 1;
SOSIBUFLOW_VAR_T(IA,'OCC_BUFFER','VIRTUALFLOW_OCC',SSS,T)$(SUM((Y,iLOUPFXSET),SOSIBUBOUND(Y,IA,'OCC_BUFFER','VIRTUALFLOW_OCC',iLOUPFXSET))>0 AND AAAOPTIFLOW(IA) AND NOT AAATRANSIT(IA)) = 1;